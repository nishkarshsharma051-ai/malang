# Create Razorpay API keys in Razorpay Dashboard Test Mode.
# Copy this file to .env and fill in your test key id and test key secret.
# Test keys work locally. Live keys are accepted only with NODE_ENV=production and an HTTPS PUBLIC_STORE_URL.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
# Shiprocket API user credentials (create a dedicated API user in Settings → API).
SHIPROCKET_API_EMAIL=api-user@example.com
SHIPROCKET_API_PASSWORD=replace_with_shiprocket_api_user_password
# Exact pickup location name already configured in your Shiprocket account.
SHIPROCKET_PICKUP_LOCATION=replace_with_shiprocket_pickup_location_name
# Packed parcel dimensions/weight; enter the actual packed tee parcel measurements.
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_PACKAGE_WEIGHT_KG=
# Email verification and paid-order receipts (Resend; sender domain must be verified).
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=M'LANG <orders@your-verified-domain.com>
# Set this to the public HTTPS storefront URL after hosting; account links, accepted host, and live-payment safety checks use it.
PUBLIC_STORE_URL=https://your-store-domain.example
PORT=4173
# Use 0.0.0.0 only for a deployed host/container. Local development defaults to 127.0.0.1.
# HOST=0.0.0.0
# Supabase project URL + server-only Secret API key (never put the secret in app.js).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Promote this verified customer account to store admin.
ADMIN_EMAIL=themalangverse@gmail.com
